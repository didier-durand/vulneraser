# Dockerfile_pi — Pi coding agent running as a dedicated "pi-agent" Linux user.
#
# The pi-agent user's home directory is /workspace, which is also the agent's
# working directory. Pi's config, sessions, and extensions live under
# /workspace/.pi/agent, so everything the agent reads or writes stays within
# the workspace (home) of the unprivileged user.
#
# Build:  docker build -f Dockerfile_pi -t pi-agent .
# Run:    docker run --rm -it -e OPENAI_API_KEY=sk-... -v "$PWD:/workspace" pi-agent
#
# Docs:   https://pi.dev  (Containerization: docs/containerization.md)

FROM node:22-bookworm-slim

# Pi needs git and ripgrep for its built-in tools.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        git \
        ripgrep \
        ; \
    rm -rf /var/lib/apt/lists/*

# Install the Pi coding agent CLI globally (as root, before switching user).
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# Verify the install.
RUN pi --version

# Create the /workspace directory (the pi-agent user's home and work directory)
# and the .pi/agent config tree inside it, all owned by pi-agent.
RUN set -eux; \
    mkdir -p /workspace/.pi/agent; \
    groupadd --system pi-agent; \
    useradd \
        --system \
        --gid pi-agent \
        --home-dir /workspace \
        --shell /bin/bash \
        --no-create-home \
        pi-agent; \
    chown -R pi-agent:pi-agent /workspace

# Run as the unprivileged pi-agent user from here on.
USER pi-agent

# Both the home directory and the working directory are /workspace.
# Pi stores config at $HOME/.pi/agent and sessions under $HOME/.pi/agent/sessions.
ENV HOME=/workspace
WORKDIR /workspace

# Default entrypoint is the Pi CLI. Arguments are passed through (e.g. -p "prompt").
ENTRYPOINT ["pi"]
CMD []
