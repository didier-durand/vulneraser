genera# Dockerfile_pi_http — Pi agent with an HTTP wrapper for Google Cloud Run.
#
# Cloud Run requires an HTTP server listening on $PORT. This image runs a small
# Node.js HTTP server (pi_http_server.mjs) that wraps Pi's RPC JSONL protocol,
# spawning a `pi --mode rpc` subprocess per request.
#
# Build:  docker build -f Dockerfile_pi_http -t pi-http .
# Run:    docker run --rm -p 8080:8080 -e OPENAI_API_KEY=sk-... pi-http
#
# Endpoints:
#   GET  /health        → {"status":"ok"}
#   POST /prompt        → {"message":"..."} → {"text":"...","model":"..."}
#   POST /prompt?stream=1 → SSE stream of text deltas

FROM node:22-bookworm-slim

# Pi needs git and ripgrep for its built-in tools.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        git \
        ripgrep \
        ; \
    rm -rf /var/lib/apt/lists/*

# Install the Pi coding agent CLI globally.
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# Copy the HTTP wrapper server into the image.
COPY pi_http_server.mjs /app/pi_http_server.mjs

# Verify the install.
RUN pi --version

WORKDIR /workspace

# Cloud Run sets PORT=8080; the server reads process.env.PORT.
EXPOSE 8080
ENTRYPOINT ["node", "/app/pi_http_server.mjs"]
